# 环境变量模板。复制为 .env.local 填值后使用。
# .env.local / .env.dev / .env.prod 已被 .gitignore 忽略；只有本 .env.example 入库。
# 加载：入口脚本启动时按 APP_ENV 选文件（默认 local），即 .env.<APP_ENV>，回退 .env。
#   默认            → 读 .env.local
#   APP_ENV=prod …  → 读 .env.prod
# 命令行/shell 传入的同名变量优先，文件只补缺。

# 抽取器：mock(占位/无 key 开发) | vlm(真多模态模型)
INGEST_EXTRACTOR=mock

# 多模态 VLM（DeepSeek V4，OpenAI 兼容接口）。密钥只填进 .env.local，勿入库。
VLM_BASE_URL=https://api.deepseek.com
VLM_MODEL=deepseek-v4-flash
VLM_API_KEY=

# 点位图片 CDN（腾讯云 COS），promote/ingest 用
CDN_BASE=https://valorant-line-up-1442886149.cos.ap-nanjing.myqcloud.com

# B站下载读哪个浏览器的 cookie（过风控）
INGEST_COOKIES_BROWSER=chrome

# GitHub CLI / API 调用 token。密钥只填进 .env.local，勿入库。
GITHUB_TOKEN=
