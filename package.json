{
  "name": "valotool",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "map:gen": "tsx scripts/map_gen.ts",
    "map:vtrace": "tsx scripts/vtracer_to_map.ts",
    "map:all": "tsx scripts/vtracer_to_map.ts src/assets/maps/bind.svg src/assets/maps/bind_calibrated.svg && tsx scripts/map_gen.ts src/assets/maps/bind_calibrated.svg",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "pnpm run build && wrangler dev",
    "deploy": "pnpm run build && wrangler deploy"
  },
  "dependencies": {
    "@ant-design/icons": "^6.2.2",
    "@valotool/lineup-content": "workspace:*",
    "@valotool/lineup-ingest": "workspace:*",
    "@dnd-kit/core": "^6.3.1",
    "@xzdarcy/react-timeline-editor": "^1.0.0",
    "@xzdarcy/timeline-engine": "^1.0.0",
    "antd": "^6.3.7",
    "konva": "^10.3.0",
    "lodash": "^4.18.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-hotkeys-hook": "^5.3.2",
    "react-konva": "^19.2.3",
    "react-resizable-panels": "^4.11.0",
    "react-router-dom": "^7.17.0",
    "react-zoom-pan-pinch": "^4.0.3",
    "xmldom": "^0.6.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.40.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "less": "^4.6.4",
    "tsx": "^4.21.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "wrangler": "^4.98.0"
  }
}